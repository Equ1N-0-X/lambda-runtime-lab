# ローカル起動（DynamoDB Local / uvicorn / Lambda RIE）向けテンプレート。
# 使い方:
#   1. cp .env.local.example .env.local
#   2. 起動中の URL・テーブル名へ書き換える
#   3. source ./.env.export.sh --local
#
# 認証情報（アクセスキー等）は書かない。DynamoDB Local ではダミー認証でよい。

AWS_REGION=us-east-1
ENVIRONMENT=local
# AWS_PROFILE=

PYTHON_API_URL=http://127.0.0.1:9001
RUST_API_URL=http://127.0.0.1:9002
DYNAMODB_TABLE_NAME=lambda-runtime-lab-contract
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8000
CONTRACT_TRANSPORT=direct
PYTHON_CONTRACT_TRANSPORT=direct
RUST_CONTRACT_TRANSPORT=lambda-rie
