# ローカル起動（DynamoDB Local / Lambda RIE）向けテンプレート。
# 使い方:
#   1. cp .env.local.example .env.local
#   2. 起動中の URL・テーブル名へ書き換える
#   3. source ./.env.export.sh --local
#
# 認証情報（アクセスキー等）は書かない。DynamoDB Local ではダミー認証でよい。

AWS_REGION=us-east-1
ENVIRONMENT=local
# AWS_PROFILE=

DYNAMODB_TABLE_NAME=lambda-runtime-lab-contract
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8000

# make contract-test は、全言語のイメージを Lambda RIE で 9101 番から順に起動するため、
# 接続先の指定は不要。手動で起動したAPIを検証する場合だけ、全言語について書く。
# PYTHON_API_URL=http://127.0.0.1:9101
# RUST_API_URL=http://127.0.0.1:9102
# CONTRACT_TRANSPORT=lambda-rie
