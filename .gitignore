.env
.env.*
!.env.example
!.env.local.example
!.env.export.sh
*.tfvars
!*.tfvars.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
htmlcov/
.coverage
build/
dist/
*.egg-info/

# Rust
target/

# Terraform
# .terraform.lock.hcl is intentionally tracked so provider versions and hashes
# stay reproducible across benchmark runs.
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Benchmark output
results/raw/*
!results/raw/.gitkeep
results/reports/*
!results/reports/.gitkeep

# Editors and operating systems
.DS_Store
.idea/
.vscode/
.cursor/
*.swp

# Local build metadata
*.log
*.pid

# make publish-images が書き出すデプロイ対象イメージ（環境ごとに異なる）
*.auto.tfvars.json

# Node.js
node_modules/
apps/typescript/dist/
