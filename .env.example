# AWSデプロイ先向けの環境変数テンプレート。
# 使い方:
#   1. cp .env.example .env
#   2. terraform output の値へ書き換える
#   3. source ./.env.export.sh
#
# ローカル起動向けは .env.local.example を使い、source ./.env.export.sh --local
# 認証情報（アクセスキー等）は書かない。AWS_PROFILE で認証先を切り替える。

AWS_REGION=ap-northeast-1
ENVIRONMENT=benchmark
# aws lambda get-function-configuration で、全言語の実装が同じ値であることを確認して設定する
ARCHITECTURE=arm64
LAMBDA_MEMORY_MB=512
# 利用中の AWS CLI プロファイル名を入れる（未使用なら行ごと削除してよい）
# AWS_PROFILE=your-profile

# APIの接続先はTerraformの出力から自動で読むため、通常は書かない。
# 別の接続先を計測する場合だけ <実装キー大文字>_API_URL（例: PYTHON_API_URL）を書く。
DYNAMODB_TABLE_NAME=
