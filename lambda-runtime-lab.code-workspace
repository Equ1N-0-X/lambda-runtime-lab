    // },
    {
      "name": "🤖 AGENT_RESOURCES",
      "path": "/Users/nagatatatsuya/development/agent_resources"
    }
  ],
  "settings": {
    // エディタの基本設定
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    // TypeScript/JavaScript設定
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "explicit"
      }
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "explicit"
      }
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "explicit"
      }
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "explicit"
      }
    },
    // ESLint設定
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ],
    "eslint.workingDirectories": [
      "./frontend"
    ],
    "eslint.format.enable": true,
    "eslint.lintTask.enable": true,
    // Prettier設定
    "prettier.singleQuote": true,
    "prettier.trailingComma": "es5",
    "prettier.semi": true,
    "prettier.tabWidth": 2,
    "prettier.printWidth": 100,
    // React Native設定
    "react-native-tools.projectRoot": "./frontend",
    // Rust設定
    "[rust]": {
      "editor.defaultFormatter": "rust-lang.rust-analyzer",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
      }
    },
    "rust-analyzer.checkOnSave.command": "clippy",
    "rust-analyzer.checkOnSave.allTargets": true,
    "rust-analyzer.cargo.loadOutDirsFromCheck": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.cargo.allFeatures": true,
    "rust-analyzer.diagnostics.disabled": [
      "unresolved-proc-macro"
    ],
    // Docker設定
    "[dockerfile]": {
      "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "docker.showStartPage": false,
    // YAML設定（AWS SAM、CloudFormation用）
    "[yaml]": {
      "editor.defaultFormatter": "redhat.vscode-yaml",
      "editor.formatOnSave": true,
      "editor.tabSize": 2
    },
    // Markdown設定
    "[markdown]": {
      "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
      "editor.wordWrap": "on",
      "editor.codeActionsOnSave": {
        "source.fixAll.markdownlint": "explicit"
      }
    },
    "markdownlint.config": {
      "MD013": false,
      "MD033": false
    },
    // JSON設定
    "[json]": {
      "editor.defaultFormatter": "vscode.json-language-features",
      "editor.formatOnSave": true
    },
    "[jsonc]": {
      "editor.defaultFormatter": "vscode.json-language-features",
      "editor.formatOnSave": true
    },
    // ファイル除外設定
    "files.exclude": {
      "**/.DS_Store": true,
      "**/.expo": true,
      "**/.git": false,
      "**/.gradle": true,
      "**/.hg": false,
      "**/.idea": true,
      "**/.next": true,
      "**/.svn": false,
      "**/.vscode": false,
      "**/build": true,
      "**/dist": true,
      "**/node_modules": true,
      "**/target": true
    },
    // 検索除外設定
    "search.exclude": {
      "**/node_modules": true,
      "**/target": true,
      "**/.next": true,
      "**/.expo": true,
      "**/build": true,
      "**/dist": true
    },
    // スペルチェッカー設定
    "cSpell.words": [
      "dynamodb",
      "localstack",
      "nosmoking",
      "tailwindcss",
      "typescriptreact"
    ],
    "cSpell.ignorePaths": [
      "node_modules",
      "target",
      ".git",
      "Cargo.lock",
      "package-lock.json",
      "yarn.lock"
    ],
    // ターミナル設定（macOS は zsh に統一：Homebrew/Graphviz 等の PATH が .zprofile で設定されるため）
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.osx": {
      "zsh": {
        "path": "/bin/zsh",
        "args": [
          "-l"
        ]
      }
    }
  },
  "extensions": {
    "recommendations": [
      // 共通
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "editorconfig.editorconfig",
      "streetsidesoftware.code-spell-checker",
      // React Native
      "msjsdiag.vscode-react-native",
      "dsznajder.es7-react-js-snippets",
      "formulahendry.auto-rename-tag",
      "bradlc.vscode-tailwindcss",
      "csstools.postcss",
      // Rust
      "rust-lang.rust-analyzer",
      "serayuzgur.crates",
      "vadimcn.vscode-lldb",
      "bungcip.better-toml",
      "tamasfe.even-better-toml",
      // AWS
      "amazonwebservices.aws-toolkit-vscode",
      "redhat.vscode-yaml",
      // Docker
      "ms-azuretools.vscode-docker",
      // DynamoDB
      "aaronpowell.vscode-dynamo-viewer",
      // Markdown
      "yzhang.markdown-all-in-one",
      "davidanson.vscode-markdownlint",
      // その他
      "ms-vsliveshare.vsliveshare",
      "eamodio.gitlens",
      "github.copilot",
      "christian-kohler.path-intellisense",
      "visualstudioexptteam.vscodeintellicode",
      "wayou.vscode-todo-highlight",
      "gruntfuggly.todo-tree"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug React Native Android",
        "cwd": "${workspaceFolder}/frontend",
        "type": "reactnative",
        "request": "launch",
        "platform": "android"
      },
      {
        "name": "Debug React Native iOS",
        "cwd": "${workspaceFolder}/frontend",
        "type": "reactnative",
        "request": "launch",
        "platform": "ios"
      },
      {
        "name": "Debug Rust Lambda",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/backend/target/debug/lambda",
        "args": [],
        "cwd": "${workspaceFolder}/backend"
      },
      {
        "name": "Attach to Node Process",
        "type": "node",
        "request": "attach",
        "restart": true,
        "port": 9229
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Frontend: Lint",
        "type": "shell",
        "command": "cd ${workspaceFolder}/frontend && npm run lint",
        "problemMatcher": [
          "$eslint-stylish"
        ],
        "group": "test"
      },
      {
        "label": "Frontend: Type Check",
        "type": "shell",
        "command": "cd ${workspaceFolder}/frontend && npm run typecheck",
        "problemMatcher": [
          "$tsc"
        ],
        "group": "test"
      },
      {
        "label": "Backend: Clippy",
        "type": "shell",
        "command": "cd ${workspaceFolder}/backend && cargo clippy -- -D warnings",
        "problemMatcher": [
          "$rustc"
        ],
        "group": "test"
      },
      {
        "label": "Backend: Test",
        "type": "shell",
        "command": "cd ${workspaceFolder}/backend && cargo test",
        "problemMatcher": [
          "$rustc"
        ],
        "group": "test"
      },
      {
        "label": "Docker: Start All",
        "type": "shell",
        "command": "cd ${workspaceFolder}/docker && docker-compose up -d",
        "problemMatcher": []
      },
      {
        "label": "Docker: Stop All",
        "type": "shell",
        "command": "cd ${workspaceFolder}/docker && docker-compose down",
        "problemMatcher": []
      }
    ]
  }
}
