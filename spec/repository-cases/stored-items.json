{
  "description": "DynamoDBが返した保存値（属性の形式）から公開するItemへの変換の共通ケース。expected.item は変換後のItem、expected.error=invalid_item は保存値の不正として依存先障害（502）にすることを表す。数値は DynamoDB が正規化して返す10進整数の表記だけを受け付ける。",
  "cases": [
    {
      "name": "canonical-item",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "123"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "item": {
          "id": "item-001",
          "value": 123,
          "payload": "payload"
        }
      }
    },
    {
      "name": "minimum-value",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "-1000000000"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "item": {
          "id": "item-001",
          "value": -1000000000,
          "payload": "payload"
        }
      }
    },
    {
      "name": "maximum-value",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "1000000000"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "item": {
          "id": "item-001",
          "value": 1000000000,
          "payload": "payload"
        }
      }
    },
    {
      "name": "longest-payload",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "123"
        },
        "payload": {
          "S": ""
        }
      },
      "expected": {
        "item": {
          "id": "item-001",
          "value": 123,
          "payload": ""
        }
      }
    },
    {
      "name": "value-above-maximum",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "1000000001"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "value-below-minimum",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "-1000000001"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "value-beyond-64-bit",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "18446744073709551616"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "value-with-fraction",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "1.5"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "value-with-zero-fraction",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "1.0"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "value-with-exponent",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "1E+2"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "value-stored-as-string",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "S": "123"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "id-outside-pattern",
      "attributes": {
        "id": {
          "S": "bad id"
        },
        "value": {
          "N": "123"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "id-stored-as-number",
      "attributes": {
        "id": {
          "N": "1"
        },
        "value": {
          "N": "123"
        },
        "payload": {
          "S": "payload"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "payload-too-long",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "123"
        },
        "payload": {
          "S": ""
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    },
    {
      "name": "payload-missing",
      "attributes": {
        "id": {
          "S": "item-001"
        },
        "value": {
          "N": "123"
        }
      },
      "expected": {
        "error": "invalid_item"
      }
    }
  ]
}
